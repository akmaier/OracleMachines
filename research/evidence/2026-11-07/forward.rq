PREFIX d: <http://purl.org/dc/terms/> PREFIX c: <http://purl.org/spar/cito/> PREFIX f: <http://purl.org/spar/fabio/> SELECT ?seed ?w ?title ?year WHERE { VALUES ?seed { <https://semopenalex.org/work/W2099977515> <https://semopenalex.org/work/W3171737424> <https://semopenalex.org/work/W1680127546> } ?w c:cites ?seed . ?w d:title ?title ; f:hasPublicationYear ?year . FILTER(REGEX(STR(?title), "learn|reason|language|neural|complex|inferen|advice|transformer", "i")) } ORDER BY DESC(?year) LIMIT 80