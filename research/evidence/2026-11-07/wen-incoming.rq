PREFIX d: <http://purl.org/dc/terms/> PREFIX c: <http://purl.org/spar/cito/> PREFIX f: <http://purl.org/spar/fabio/> SELECT ?seed ?w ?title ?year WHERE { VALUES ?seed { <https://semopenalex.org/work/W1551696747> <https://semopenalex.org/work/W1646008629> } ?w c:cites ?seed . ?w d:title ?title . OPTIONAL { ?w f:hasPublicationYear ?year } } LIMIT 100